<?xml version="1.0" encoding="utf-8"?>
<!-- Pay-cycle widget (SummaryWidget.java). RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/summary_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="This pay cycle"
        android:textColor="@color/wr_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/summary_earned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/wr_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/summary_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/wr_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/summary_net"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/wr_accent"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
